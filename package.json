{
  "name": "@node-zugferd/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jslno/node-zugferd.git"
  },
  "scripts": {
    "build": "turbo build --filter=./packages/**/* --concurrency=2",
    "dev": "turbo dev --filter=./packages/**/* --filter=!./packages/cli",
    "gen": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --import tsx\" plop --plopfile=./scripts/generators/config.ts",
    "format": "biome format . --write",
    "clean": "turbo clean --filter=./packages/* && rm -rf node_modules",
    "lint": "biome check . --error-on-warnings",
    "lint:dependencies": "knip && knip --production",
    "lint:fix": "biome check . --fix --unsafe",
    "lint:spell": "cspell . --color",
    "lint:types": "turbo lint:types --filter=./packages/**/*",
    "lint:packages": "turbo lint:packages --filter=./packages/**/*",
    "changeset": "changeset",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:release": "turbo clean --filter=./packages/**/* && turbo build --filter=./packages/**/* && changeset publish",
    "test": "turbo test --continue --filter=./packages/**/*",
    "coverage": "turbo coverage --filter=./packages/**/*",
    "postcoverage": "pnpm coverage:collect && pnpm coverage:merge && pnpm coverage:report",
    "coverage:merge": "nyc merge coverage/raw coverage/merged/merged-coverage.json",
    "coverage:collect": "rm -rf coverage && mkdir -p coverage/raw && for f in $(find packages test -name coverage-final.json); do pkg=$(basename \"$(dirname \"$(dirname \"$f\")\")\"); cp \"$f\" \"./coverage/raw/$pkg-coverage-final.json\"; done",
    "coverage:report": "nyc --temp-dir=./coverage/raw report --reporter=lcov --reporter text-summary",
    "coverage:open": "open coverage/lcov-report/index.html",
    "e2e:smoke": "turbo e2e:smoke",
    "e2e:integration": "turbo e2e:integration",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.12",
    "@biomejs/js-api": "^4.0.0",
    "@biomejs/wasm-nodejs": "^2.4.15",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@turbo/gen": "^2.9.14",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/serialize-javascript": "^5.0.4",
    "@vitest/coverage-istanbul": "catalog:vitest",
    "@vitest/ui": "catalog:vitest",
    "cross-env": "^10.1.0",
    "cspell": "^10.0.0",
    "knip": "^6.6.0",
    "nyc": "^18.0.0",
    "plop": "^4.0.5",
    "publint": "^0.3.18",
    "serialize-javascript": "^7.0.5",
    "tsx": "^4.22.3",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:vitest",
    "xmlbuilder2": "catalog:"
  }
}
