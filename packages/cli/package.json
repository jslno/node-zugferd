{
  "name": "@node-zugferd/cli",
  "version": "1.0.0-beta.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "executableFiles": [
      "./dist/index.mjs"
    ]
  },
  "bin": {
    "node-zugferd": "./dist/index.mjs",
    "zugferd": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "dev:setup": "bash ./scripts/setup.sh",
    "dev:reset": "bash ./scripts/reset.sh",
    "dev": "pnpm dev:setup && tsx ./src/index.ts",
    "start": "node ./dist/index.mjs",
    "lint:package": "publint run --strict --pack false",
    "lint:types": "attw --profile esm-only --pack .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest",
    "coverage": "vitest run --coverage --coverage.provider=istanbul"
  },
  "dependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@biomejs/js-api": "catalog:biome",
    "@biomejs/wasm-nodejs": "catalog:biome",
    "@clack/prompts": "^1.8.1",
    "@node-zugferd/basic": "workspace:*",
    "@node-zugferd/basic-wl": "workspace:*",
    "@node-zugferd/core": "workspace:*",
    "@node-zugferd/en-16931": "workspace:*",
    "@node-zugferd/extended": "workspace:*",
    "@node-zugferd/minimum": "workspace:*",
    "c12": "4.0.0-rc.4",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "get-tsconfig": "^4.14.3",
    "node-zugferd": "workspace:*",
    "semver": "^7.8.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@node-zugferd/parser": "workspace:*",
    "@node-zugferd/validator-mustang": "workspace:*",
    "@node-zugferd/validator-xsd": "workspace:*",
    "@types/semver": "^7.8.0",
    "jiti": "^2.7.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "type-fest": "^5.10.0"
  },
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ]
}
