  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@copilotkit/aimock": "^1.48.1",
    "@tanstack/ai": "^1.8.0",
    "ai": "^7.0.178",
    "tsdown": "catalog:",
    "tsx": "catalog:"
