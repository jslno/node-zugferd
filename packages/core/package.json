{
  "name": "@node-zugferd/core",
  "version": "1.0.0-beta.0",
  "types": "dist/index.d.mts",
  "license": "MIT",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint:package": "publint run --strict --pack false",
    "lint:types": "attw --profile esm-only --pack .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest",
    "coverage": "vitest run --coverage --coverage.provider=istanbul"
  },
  "peerDependencies": {
    "xmlbuilder2": "catalog:"
  },
  "dependencies": {
    "@standard-schema/spec": "latest"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./utils": {
      "dev-source": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.mts",
      "default": "./dist/utils/index.mjs"
    },
    "./error": {
      "dev-source": "./src/error/index.ts",
      "types": "./dist/error/index.d.mts",
      "default": "./dist/error/index.mjs"
    },
    "./types": {
      "dev-source": "./src/types/index.ts",
      "types": "./dist/types/index.d.mts",
      "default": "./dist/types/index.mjs"
    },
    "./data-types": {
      "dev-source": "./src/data-types/index.ts",
      "types": "./dist/data-types/index.d.mts",
      "default": "./dist/data-types/index.mjs"
    }
  },
  "files": [
    "dist"
  ]
}
