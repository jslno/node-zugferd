{
  "name": "@node-zugferd/pdf-template",
  "version": "1.0.0-beta.0",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint:package": "publint run --strict --pack false",
    "lint:types": "attw --profile esm-only --pack .",
    "typecheck": "tsc --project tsconfig.json"
  },
  "peerDependencies": {
    "@node-zugferd/templates": "workspace:*"
  },
  "dependencies": {
    "@node-zugferd/core": "workspace:*",
    "boxpdf": "^1.13.0",
    "intl-messageformat": "^12.1.4",
    "pdf-lib": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ]
}
